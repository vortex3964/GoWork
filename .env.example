API_KEY=insert_your_key

# the ai provider: google, anthropic, groq, openAi, ollama, llamaCpp, lmStudio
PROVIDER=ai_provider

#the ai model
model=your_ai_model

# Ollama (optional defaults to http://localhost:11434 if unset)
OLLAMA_HOST=http://localhost:11434

# llama.cpp (optional defaults to http://localhost:8080 if unset)
LLAMACPP_HOST=http://localhost:8080

# LM Studio (optional defaults to http://localhost:1234/v1 if unset)
LMSTUDIO_HOST=http://localhost:1234/v1
